  <key>NSCameraUsageDescription</key><string>用于拍摄照片或视频发到 U</string>
  <key>NSMicrophoneUsageDescription</key><string>用于录制带声音的视频</string>
  <key>NSLocalNetworkUsageDescription</key><string>用于发现同一局域网里的 U 服务器</string>
  <key>NSBonjourServices</key>
  <array>
    <string>_u._udp</string>
    <string>_u-server._tcp</string>
  </array>
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoads</key><true/>
    <key>NSAllowsLocalNetworking</key><true/>
  </dict>
</dict>
</plist>
